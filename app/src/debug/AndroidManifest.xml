<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets tests start sessions over adb, also while the phone is locked, e.g.
     adb shell am start-foreground-service -n org.urbackup.client.android/.BackupService -a org.urbackup.client.android.BACKUP_NOW -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <service
            android:name=".BackupService"
            android:exported="true"
            tools:replace="android:exported" />
    </application>
</manifest>
